<?xml version="1.0" encoding="UTF-8"?>
<!-- Redesigned for Catppuccin Mocha dark theme — Wireframe C layout -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <!-- ── Shared objects ── -->
  <object class="GtkTextBuffer" id="output-log-buffer"/>

  <object class="GtkFileFilter" id="toml_filter">
    <patterns>
      <pattern>*.toml</pattern>
    </patterns>
  </object>

  <!-- ── About dialog ── -->
  <object class="GtkAboutDialog" id="about-dialog">
    <property name="can-focus">False</property>
    <property name="window-position">center</property>
    <property name="icon">resource:///net/olback/library-loader/icon-svg</property>
    <property name="type-hint">dialog</property>
    <property name="gravity">center</property>
    <property name="transient-for">main-window</property>
    <property name="attached-to">main-window</property>
    <property name="program-name">Library Loader</property>
    <property name="version">{{version}}</property>
    <property name="copyright" translatable="yes">Edwin Svensson</property>
    <property name="website">https://github.com/olback/library-loader</property>
    <property name="website-label" translatable="yes">Library Loader on Github</property>
    <property name="authors">{{authors}}</property>
    <property name="artists">OpenClipart-Vectors (logo / program icon)</property>
    <property name="logo">resource:///net/olback/library-loader/icon-svg</property>
    <property name="license-type">agpl-3-0</property>
    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox">
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">0</property>
          </packing>
        </child>
      </object>
    </child>
  </object>

  <!-- ══════════════════════════════════════════
       Main application window
       ══════════════════════════════════════════ -->
  <object class="GtkApplicationWindow" id="main-window">
    <property name="width-request">420</property>
    <property name="height-request">600</property>
    <property name="visible">True</property>
    <property name="can-focus">True</property>
    <property name="icon">resource:///net/olback/library-loader/icon-svg</property>

    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>

        <!-- Error / notification info bar -->
        <child>
          <object class="GtkInfoBar" id="info-bar">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="show-close-button">True</property>
            <property name="revealed">False</property>
            <child internal-child="action_area">
              <object class="GtkButtonBox">
                <property name="can-focus">False</property>
                <property name="layout-style">end</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">False</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child internal-child="content_area">
              <object class="GtkBox">
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <child>
                  <object class="GtkLabel" id="info-bar-label">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">label</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">False</property>
                <property name="position">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>

        <!-- Main stack -->
        <child>
          <object class="GtkStack" id="main-stack">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="transition-duration">120</property>
            <property name="transition-type">crossfade</property>

            <!-- ── Spinner page ── -->
            <child>
              <object class="GtkSpinner">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="active">True</property>
              </object>
              <packing>
                <property name="name">spinner</property>
                <property name="title" translatable="yes">Spinner</property>
              </packing>
            </child>

            <!-- ── Login page ── -->
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="spacing">14</property>
                <property name="margin-start">40</property>
                <property name="margin-end">40</property>
                <property name="margin-top">40</property>
                <property name="margin-bottom">40</property>

                <!-- Heading -->
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">Sign In</property>
                    <style>
                      <class name="login-heading"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>

                <!-- Subtitle -->
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">componentsearchengine.com</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>

                <!-- Username -->
                <child>
                  <object class="GtkEntry" id="username-entry">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="placeholder-text" translatable="yes">Username</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">2</property>
                  </packing>
                </child>

                <!-- Password -->
                <child>
                  <object class="GtkEntry" id="password-entry">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="visibility">False</property>
                    <property name="invisible-char">●</property>
                    <property name="input-purpose">password</property>
                    <property name="placeholder-text" translatable="yes">Password</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">3</property>
                  </packing>
                </child>

                <!-- Login button -->
                <child>
                  <object class="GtkButton" id="login-button">
                    <property name="label" translatable="yes">Sign In</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <property name="hexpand">True</property>
                    <property name="margin-top">4</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">4</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="name">login</property>
                <property name="title" translatable="yes">Login</property>
                <property name="position">1</property>
              </packing>
            </child>

            <!-- ══════════════════════════════════════
                 WATCH page — main redesigned layout
                 ══════════════════════════════════════ -->
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>

                <!-- Quick Actions Row -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">14</property>
                    <property name="margin-end">14</property>
                    <property name="margin-top">10</property>
                    <property name="margin-bottom">10</property>
                    <child>
                      <object class="GtkButton" id="import-ecad-button">
                        <property name="label" translatable="yes">+ Import ECAD</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="hexpand">True</property>
                        <style>
                          <class name="primary-btn"/>
                        </style>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="search-parts-button">
                        <property name="label" translatable="yes">Search Parts</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="hexpand">True</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>

                <!-- Top divider -->
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>

                <!-- Scrollable main content -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="shadow-type">none</property>
                    <child>
                      <object class="GtkViewport">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="shadow-type">none</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">14</property>
                            <property name="margin-end">14</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>

                            <!-- ── WATCHER section ── -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>

                                <!-- Section header row -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="label" translatable="yes">WATCHER</property>
                                        <property name="halign">start</property>
                                        <style>
                                          <class name="section-heading"/>
                                        </style>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">0</property>
                                      </packing>
                                    </child>
                                    <!-- Spacer -->
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="hexpand">True</property>
                                      </object>
                                      <packing>
                                        <property name="expand">True</property>
                                        <property name="fill">True</property>
                                        <property name="position">1</property>
                                      </packing>
                                    </child>
                                    <!-- "● Active" label (shown when watching) -->
                                    <child>
                                      <object class="GtkLabel" id="watcher-active-indicator">
                                        <property name="visible">False</property>
                                        <property name="can-focus">False</property>
                                        <property name="label" translatable="yes">● Active</property>
                                        <style>
                                          <class name="active-label"/>
                                        </style>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">2</property>
                                      </packing>
                                    </child>
                                    <!-- Watcher toggle switch -->
                                    <child>
                                      <object class="GtkSwitch" id="watcher-switch">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="valign">center</property>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">3</property>
                                      </packing>
                                    </child>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>

                                <!-- Watcher card -->
                                <child>
                                  <object class="GtkFrame">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <style>
                                      <class name="card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">8</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">12</property>
                                        <property name="margin-bottom">12</property>

                                        <!-- Path row: entry + browse -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <child>
                                              <object class="GtkEntry" id="watch-path-entry">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="hexpand">True</property>
                                                <property name="placeholder-text" translatable="yes">~/Downloads</property>
                                              </object>
                                              <packing>
                                                <property name="expand">True</property>
                                                <property name="fill">True</property>
                                                <property name="position">0</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="watch-path-browse">
                                                <property name="label" translatable="yes">Browse</property>
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <style>
                                                  <class name="small-btn"/>
                                                </style>
                                              </object>
                                              <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">False</property>
                                                <property name="position">1</property>
                                              </packing>
                                            </child>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">0</property>
                                          </packing>
                                        </child>

                                        <!-- Recursive checkbox -->
                                        <child>
                                          <object class="GtkCheckButton" id="watch-recursive">
                                            <property name="label" translatable="yes">Watch subfolders</property>
                                            <property name="visible">True</property>
                                            <property name="can-focus">True</property>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">False</property>
                                            <property name="position">1</property>
                                          </packing>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>

                            <!-- ── ECAD TOOL section (KiCad only for now) ── -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>

                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">ECAD TOOL</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="section-heading"/>
                                    </style>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>

                                <!-- Single active chip — KiCad -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="orientation">horizontal</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="label" translatable="yes">KiCad</property>
                                        <style>
                                          <class name="chip-active"/>
                                        </style>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">0</property>
                                      </packing>
                                    </child>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>

                            <!-- ── OUTPUT PATHS section ── -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>

                                <!-- Section heading -->
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">OUTPUT PATHS</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="section-heading"/>
                                    </style>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>

                                <!-- Fixed KiCad path rows card -->
                                <child>
                                  <object class="GtkFrame">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <style>
                                      <class name="card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="orientation">vertical</property>

                                        <!-- Row: Symbols -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-start">10</property>
                                            <property name="margin-end">10</property>
                                            <property name="margin-top">9</property>
                                            <property name="margin-bottom">9</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="label" translatable="yes">Symbols</property>
                                                <property name="halign">start</property>
                                                <property name="width-chars">10</property>
                                                <style>
                                                  <class name="format-title"/>
                                                </style>
                                              </object>
                                              <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">False</property>
                                                <property name="position">0</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkEntry" id="kicad-symbols-entry">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="hexpand">True</property>
                                                <property name="placeholder-text" translatable="yes">Select folder…</property>
                                              </object>
                                              <packing>
                                                <property name="expand">True</property>
                                                <property name="fill">True</property>
                                                <property name="position">1</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="kicad-symbols-browse">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <style>
                                                  <class name="folder-btn"/>
                                                </style>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="visible">True</property>
                                                    <property name="can-focus">False</property>
                                                    <property name="icon-name">folder-open-symbolic</property>
                                                    <property name="icon-size">1</property>
                                                  </object>
                                                </child>
                                              </object>
                                              <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">False</property>
                                                <property name="position">2</property>
                                              </packing>
                                            </child>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">0</property>
                                          </packing>
                                        </child>

                                        <!-- Separator -->
                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">1</property>
                                          </packing>
                                        </child>

                                        <!-- Row: Footprints -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-start">10</property>
                                            <property name="margin-end">10</property>
                                            <property name="margin-top">9</property>
                                            <property name="margin-bottom">9</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="label" translatable="yes">Footprints</property>
